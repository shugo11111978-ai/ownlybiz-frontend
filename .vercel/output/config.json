{
  "version": 3,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/cgi-sys/(.*)$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/data/(.*)$",
      "dest": "/data/$1"
    },
    {
      "src": "^/blog/index.json$",
      "dest": "/api/blog-index"
    },
    {
      "src": "^/llms.txt$",
      "dest": "/api/llms"
    },
    {
      "src": "^/favicon.svg$",
      "dest": "/favicon.svg"
    },
    {
      "src": "^/robots.txt$",
      "dest": "/api/robots"
    },
    {
      "src": "^/sitemap.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/.well-known/(.*)$",
      "dest": "/.well-known/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/seo-shell"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/media/website/([^/]+)$",
      "dest": "/api/media/website/[id]?id=$1",
      "check": true
    },
    {
      "src": "^/api(/.*)?$",
      "status": 404
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    },
    {
      "handle": "miss"
    },
    {
      "src": "^/api/(.+)(?:\\.(?:js))$",
      "dest": "/api/$1",
      "check": true
    }
  ],
  "crons": []
}
